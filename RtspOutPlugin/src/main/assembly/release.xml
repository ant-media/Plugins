<assembly xmlns="http://maven.apache.org/ASSEMBLY/2.1.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/ASSEMBLY/2.1.0 https://maven.apache.org/xsd/assembly-2.1.0.xsd">
    <id>release</id>
    <formats>
        <format>zip</format>
    </formats>
    <includeBaseDirectory>true</includeBaseDirectory>
    <baseDirectory>RTSP-Out-Plugin</baseDirectory>

    <files>
        <file>
            <source>${project.build.directory}/${project.build.finalName}.jar</source>
            <destName>${project.build.finalName}.jar</destName>
            <fileMode>0644</fileMode>
        </file>
        <file>
            <source>src/main/native/linux-x86_64/mediamtx</source>
            <destName>mediamtx</destName>
            <fileMode>0755</fileMode>
        </file>
        <file>
            <source>src/main/native/linux-x86_64/LICENSE</source>
            <destName>mediamtx-LICENSE</destName>
            <fileMode>0644</fileMode>
        </file>
        <file>
            <source>src/main/script/install-rtsp-out-plugin.sh</source>
            <destName>install-rtsp-out-plugin.sh</destName>
            <fileMode>0755</fileMode>
        </file>
    </files>
</assembly>
